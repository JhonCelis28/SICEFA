@startuml Flujo_Reportes
title **INFRASTOCK - Diagrama de Actividades: Generación de Reportes**

|#LightYellow| Administrador |
|#LightGreen| Sistema |

|Administrador|
start
:Acceder al módulo de Reportes;

switch (¿Tipo de reporte?)
case (Consumo por Área)
  :Seleccionar "Consumo por\nÁrea Productiva";
  
  |Sistema|
  :Cargar filtros:\n- Año\n- Mes;
  
  |Administrador|
  :Seleccionar año y mes;
  :Aplicar filtros;
  
  |Sistema|
  :Consultar WarehouseMovement\n(role='Entrega',\nitem_type='equipment');
  :Agrupar por ProductiveUnit;
  :Calcular totales por área;
  :Obtener Top 10 insumos\nmás consumidos;
  :Mostrar reporte:\n- Tabla de consumo por área\n- Top 10 insumos\n- Lista detallada de\n  transacciones;
  
  |Administrador|
  if (¿Exportar reporte?) then (Sí)
    if (¿Formato?) then (PDF)
      |Sistema|
      :Generar PDF con:\n- Logo institucional\n- Nombre del admin\n- Datos tabulados\n- Estadísticas;
      :Descargar PDF;
    else (Excel)
      |Sistema|
      :Generar Excel con:\n- Datos tabulados\n- Fórmulas de totales;
      :Descargar Excel;
    endif
  else (No)
    :Continuar visualizando;
  endif

case (Herramientas por Instructor)
  :Seleccionar "Herramientas\npor Instructor";
  
  |Sistema|
  :Cargar filtros:\n- Año\n- Mes;
  
  |Administrador|
  :Seleccionar año y mes;
  :Aplicar filtros;
  
  |Sistema|
  :Consultar WarehouseMovement\n(role='Préstamo',\nitem_type='tool');
  :Agrupar por Instructor (User);
  :Calcular préstamos\npor instructor;
  :Obtener Top 10 herramientas\nmás prestadas;
  :Mostrar reporte:\n- Tabla de préstamos\n  por instructor\n- Top 10 herramientas\n- Lista detallada;
  
  |Administrador|
  if (¿Exportar reporte?) then (Sí)
    if (¿Formato?) then (PDF)
      |Sistema|
      :Generar PDF con:\n- Logo institucional\n- Datos de préstamos\n- Estadísticas;
      :Descargar PDF;
    else (Excel)
      |Sistema|
      :Generar Excel con\ndatos tabulados;
      :Descargar Excel;
    endif
  else (No)
    :Continuar visualizando;
  endif

case (Exportar Solicitudes)
  :Seleccionar exportar\nsolicitudes de insumos;
  
  |Sistema|
  :Cargar filtros de período:\n- Mensual\n- Trimestral\n- Anual;
  
  |Administrador|
  :Seleccionar período;
  
  |Sistema|
  :Consultar solicitudes\naprobadas en el período;
  :Calcular estadísticas:\n- Total solicitudes\n- Top insumos consumidos\n- Distribución por área;
  
  if (¿Formato?) then (PDF)
    :Generar PDF de consumo;
    :Descargar PDF;
  else (Excel)
    :Generar Excel de consumo;
    :Descargar Excel;
  endif

case (Exportar Préstamos)
  :Seleccionar exportar\npréstamos;
  
  |Sistema|
  :Cargar filtros de período;
  
  |Administrador|
  :Seleccionar período;
  
  |Sistema|
  :Consultar préstamos\nen el período;
  :Calcular estadísticas:\n- Total préstamos\n- Top herramientas\n- Devoluciones pendientes;
  
  if (¿Formato?) then (PDF)
    :Generar PDF de préstamos;
    :Descargar PDF;
  else (Excel)
    :Generar Excel de préstamos;
    :Descargar Excel;
  endif

endswitch

stop

legend right
  |= Reporte |= Fuente de datos |
  | Consumo por Área | WarehouseMovement (Entrega) |
  | Herramientas por Instructor | WarehouseMovement (Préstamo) |
  | Solicitudes | Request + RequestItem |
  | Préstamos | WarehouseMovement (tool) |
endlegend

@enduml
