@startuml Flujo_Prestamo_Herramientas
title **INFRASTOCK - Diagrama de Actividades: Préstamo de Herramientas**

|#LightCoral| Instructor |
|#LightGreen| Sistema |
|#LightYellow| Administrador |

|Instructor|
start
:Acceder al módulo\n"Mis Préstamos";
:Seleccionar "Nuevo Préstamo";

|Sistema|
:Cargar formulario de préstamo;
:Mostrar herramientas disponibles\n(excluir las en mantenimiento);

|Instructor|
:Seleccionar herramienta;
:Seleccionar unidad productiva;
:Ingresar cantidad solicitada;
:Ingresar finalidad del préstamo;
:Seleccionar fecha requerida;
:Adjuntar imagen de entrega (opcional);
:Enviar solicitud de préstamo;

|Sistema|
:Validar datos del formulario;

if (¿Datos válidos?) then (Sí)
  :Verificar estado de la herramienta;
  
  if (¿Herramienta en mantenimiento?) then (Sí)
    :Mostrar error:\n"Herramienta en mantenimiento,\nno disponible para préstamo";
    
    |Instructor|
    :Seleccionar otra herramienta;
    stop
    
  else (No)
    if (¿Cantidad disponible suficiente?) then (Sí)
      :Crear WarehouseMovement\n(role='Préstamo', item_type='tool',\nstatus='pending');
      :Enviar notificación al\nAdministrador (loan_created);
      
      |Instructor|
      :Recibir confirmación\n"Préstamo registrado exitosamente";
      
      |Administrador|
      :Recibir notificación\n"Nueva solicitud de préstamo";
      :Revisar detalles del préstamo;
      
      if (¿Aprobar préstamo?) then (Aprobar)
        :Aprobar préstamo;
        
        |Sistema|
        :Actualizar WarehouseMovement\n(status = 'approved');
        :Decrementar cantidad_disponible\nde la herramienta;
        
        if (¿cantidad_disponible = 0?) then (Sí)
          :Actualizar estado herramienta\na 'en_prestamo';
        else (No)
          :Mantener estado 'disponible';
        endif
        
        :Enviar notificación al instructor\n(loan_approved);
        
        |Instructor|
        :Recibir notificación\n"Préstamo aprobado";
        :Recibir herramienta;
        
        note right
          El instructor ahora puede
          devolver la herramienta
          (ver diagrama de devolución)
        end note
        
        :**Usar herramienta**;
        
        fork
          :Solicitar devolución;
          :Ingresar descripción;
          :Adjuntar imagen de devolución;
          :Enviar devolución;
          
          |Sistema|
          :Verificar que el préstamo\nesté aprobado;
          :Verificar que no exista\notra devolución pendiente;
          :Crear WarehouseMovement\n(role='Devolución', status='pending');
          :Notificar al admin\n(return_created);
          
          |Administrador|
          :Recibir notificación\n"Nueva devolución de herramienta";
          :Revisar devolución;
          
          if (¿Aprobar devolución?) then (Aprobar)
            :Aprobar devolución;
            
            |Sistema|
            :Actualizar devolución\n(status='approved');
            :Incrementar cantidad_disponible;
            :Actualizar estado herramienta\na 'disponible' si corresponde;
            :Notificar al instructor\n(return_approved);
            
          else (Rechazar)
            :Rechazar devolución;
            :Ingresar motivo;
            
            |Sistema|
            :Actualizar devolución\n(status='rejected');
            :Notificar al instructor\n(return_rejected);
            
          endif
        fork again
        end fork
        
      else (Rechazar)
        :Rechazar préstamo;
        :Ingresar motivo de rechazo;
        
        |Sistema|
        :Actualizar WarehouseMovement\n(status = 'rejected');
        :Enviar notificación al instructor\n(loan_rejected);
        
        |Instructor|
        :Recibir notificación\n"Préstamo rechazado"\ncon motivo;
        
      endif
      
    else (No)
      :Mostrar error:\n"Cantidad no disponible";
      
      |Instructor|
      :Ajustar cantidad;
      stop
      
    endif
  endif
  
else (No)
  :Mostrar errores de validación;
  
  |Instructor|
  :Corregir datos del formulario;
  
endif

stop

legend right
  |= Estado |= Descripción |
  | pending | Préstamo pendiente de aprobación |
  | approved | Préstamo aprobado |
  | rejected | Préstamo rechazado |
  | en_prestamo | Herramienta prestada (sin stock) |
  | disponible | Herramienta disponible |
endlegend

@enduml
