@startuml Flujo_Gestion_Insumos
title **INFRASTOCK - Diagrama de Actividades: Gestión de Insumos (Administrador)**

|#LightYellow| Administrador |
|#LightGreen| Sistema |

|Administrador|
start
:Acceder al módulo\n"Gestión de Insumos";

|Sistema|
:Cargar lista de insumos\ncon paginación y búsqueda;
:Verificar insumos próximos\na vencer (cada 5 minutos);

if (¿Insumos por vencer?) then (Sí)
  :Crear notificaciones\n(supply_expiring)\ncon escalamiento progresivo;
endif

|Administrador|

switch (¿Qué acción realizar?)
case (Crear)
  :Seleccionar "Nuevo Insumo";
  
  |Sistema|
  :Cargar formulario con\ncategorías y unidades;
  
  |Administrador|
  :Ingresar datos:\n- Nombre\n- Categoría\n- Cantidad inicial\n- Stock mínimo\n- Unidad de medida\n- Fecha de vencimiento\n- Descripción;
  :Enviar formulario;
  
  |Sistema|
  :Validar datos;
  
  if (¿Datos válidos?) then (Sí)
    :Crear registro Equipment;
    :Inicializar stock\n(initial_amount);
    :Mostrar mensaje de éxito;
  else (No)
    :Mostrar errores\nde validación;
  endif

case (Editar)
  :Seleccionar insumo a editar;
  
  |Sistema|
  :Cargar formulario con\ndatos actuales del insumo;
  
  |Administrador|
  :Modificar campos necesarios;
  :Guardar cambios;
  
  |Sistema|
  :Validar datos;
  :Actualizar registro Equipment;
  :Mostrar mensaje de éxito;

case (Eliminar)
  :Seleccionar insumo a eliminar;
  
  |Sistema|
  :Verificar registros\nrelacionados;
  
  if (¿Tiene relaciones activas?) then (Sí)
    :Mostrar error:\n"No se puede eliminar,\ntiene registros relacionados";
  else (No)
    :Mostrar confirmación;
    
    |Administrador|
    if (¿Confirmar eliminación?) then (Sí)
      |Sistema|
      :Eliminar registro Equipment;
      :Mostrar mensaje de éxito;
    else (No)
      :Cancelar operación;
    endif
  endif

case (Ver Detalle)
  :Seleccionar insumo;
  
  |Sistema|
  :Mostrar detalle completo:\n- Información general\n- Stock actual\n- Movimientos asociados\n- Historial de entregas;

case (Exportar)
  |Administrador|
  
  if (¿Formato de exportación?) then (PDF)
    |Sistema|
    :Generar reporte PDF\ncon logo y datos;
    :Descargar archivo PDF;
  else (Excel)
    |Sistema|
    :Generar archivo Excel\ncon datos tabulados;
    :Descargar archivo Excel;
  endif

case (Préstamo de Insumo)
  :Seleccionar "Nuevo Préstamo\nde Insumo";
  
  |Sistema|
  :Cargar formulario;
  
  |Administrador|
  :Seleccionar insumo;
  :Seleccionar usuario;
  :Ingresar cantidad;
  :Enviar préstamo;
  
  |Sistema|
  :Crear WarehouseMovement\n(role='Préstamo' + 'Entrega');
  :Descontar stock;
  :Mostrar mensaje de éxito;

endswitch

stop

legend right
  |= Cálculo de Stock |
  | stock = initial_amount - used_amount |
  | used_amount = Σ(Entrega) - Σ(Recibe) |
endlegend

@enduml
