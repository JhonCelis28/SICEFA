@startuml Flujo_Gestion_Herramientas
title **INFRASTOCK - Diagrama de Actividades: Gestión de Herramientas (Administrador)**

|#LightYellow| Administrador |
|#LightGreen| Sistema |

|Administrador|
start
:Acceder al módulo\n"Gestión de Herramientas";

|Sistema|
:Cargar lista de herramientas\ncon paginación y búsqueda;

|Administrador|

switch (¿Qué acción realizar?)
case (Crear)
  :Seleccionar "Nueva Herramienta";
  
  |Sistema|
  :Cargar formulario con\ncategorías disponibles;
  
  |Administrador|
  :Ingresar datos:\n- Nombre\n- Placa\n- Marca\n- Modelo\n- Estado\n- Cantidad total\n- Cantidad disponible\n- Categoría\n- Imagen (opcional);
  :Enviar formulario;
  
  |Sistema|
  :Validar datos;
  
  if (¿Datos válidos?) then (Sí)
    :Crear registro Tool;
    
    if (¿Se adjuntó imagen?) then (Sí)
      :Almacenar imagen en\nstorage público;
    endif
    
    :Mostrar mensaje de éxito;
  else (No)
    :Mostrar errores\nde validación;
  endif

case (Editar)
  :Seleccionar herramienta\na editar;
  
  |Sistema|
  :Cargar formulario con\ndatos actuales;
  
  |Administrador|
  :Modificar campos necesarios;
  :Actualizar imagen (opcional);
  :Guardar cambios;
  
  |Sistema|
  :Validar datos;
  
  if (¿Se cambió la imagen?) then (Sí)
    :Eliminar imagen anterior;
    :Almacenar nueva imagen;
  endif
  
  :Actualizar registro Tool;
  :Mostrar mensaje de éxito;

case (Eliminar)
  :Seleccionar herramienta\na eliminar;
  
  |Sistema|
  :Verificar préstamos activos\ny devoluciones pendientes;
  
  if (¿Tiene préstamos activos?) then (Sí)
    :Mostrar error:\n"No se puede eliminar,\ntiene préstamos activos";
  else (No)
    if (¿Tiene devoluciones pendientes?) then (Sí)
      :Mostrar error:\n"No se puede eliminar,\ntiene devoluciones pendientes";
    else (No)
      :Mostrar confirmación;
      
      |Administrador|
      if (¿Confirmar eliminación?) then (Sí)
        |Sistema|
        
        if (¿Tiene imagen?) then (Sí)
          :Eliminar imagen\ndel storage;
        endif
        
        :Eliminar registro Tool;
        :Mostrar mensaje de éxito;
      else (No)
        :Cancelar operación;
      endif
    endif
  endif

case (Ver Detalle)
  :Seleccionar herramienta;
  
  |Sistema|
  :Mostrar detalle completo:\n- Información general\n- Estado actual\n- Cantidad disponible\n- Historial de préstamos;

case (Exportar)
  |Administrador|
  
  if (¿Formato de exportación?) then (PDF)
    |Sistema|
    :Generar reporte PDF\ncon logo y datos;
    :Descargar archivo PDF;
  else (Excel)
    |Sistema|
    :Generar archivo Excel\ncon datos tabulados;
    :Descargar archivo Excel;
  endif

endswitch

stop

legend right
  |= Estado de Herramienta |= Descripción |
  | disponible | Lista para préstamo |
  | en_prestamo | Todas las unidades prestadas |
  | mantenimiento | No disponible para préstamo |
endlegend

@enduml
