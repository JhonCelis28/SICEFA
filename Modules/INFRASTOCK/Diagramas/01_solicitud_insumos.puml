@startuml Flujo_Solicitud_Insumos
title **INFRASTOCK - Diagrama de Actividades: Solicitud de Insumos**

|#LightBlue| Usuario (Solicitante) |
|#LightGreen| Sistema |
|#LightYellow| Administrador |

|Usuario (Solicitante)|
start
:Acceder al módulo de solicitudes;
:Seleccionar "Nueva Solicitud";

|Sistema|
:Cargar formulario de solicitud;
:Mostrar unidades productivas\ny lista de insumos disponibles;

|Usuario (Solicitante)|
:Seleccionar unidad productiva/almacén;
:Seleccionar insumos y cantidades;
:Agregar descripción (opcional);
:Enviar solicitud;

|Sistema|
:Validar datos del formulario;

if (¿Datos válidos?) then (Sí)
  :Verificar stock disponible\npara cada insumo;
  
  if (¿Stock suficiente para todos?) then (Sí)
    :Crear registro de Solicitud\n(status = 'pending');
    :Crear registros de RequestItem\n(uno por cada insumo);
    :Enviar notificación al\nAdministrador (request_created);
    
    |Usuario (Solicitante)|
    :Recibir confirmación\n"Solicitud creada exitosamente";
    
    |Administrador|
    :Recibir notificación\n"Nueva solicitud de insumos";
    :Revisar detalles de la solicitud;
    :Verificar items, cantidades\ny usuario solicitante;
    
    if (¿Aprobar solicitud?) then (Aprobar)
      :Aprobar solicitud;
      
      |Sistema|
      :Actualizar Solicitud\n(status = 'approved');
      :Actualizar todos los RequestItem\n(status = 'approved');
      :Crear WarehouseMovement\n(role = 'Entrega') por cada item;
      :Crear registro de Surplus\n(surplus_amount = 0) por cada item;
      :Descontar stock de cada insumo;
      :Enviar notificación al usuario\n(request_approved);
      
      |Usuario (Solicitante)|
      :Recibir notificación\n"Solicitud aprobada";
      :Recibir insumos;
      
    else (Rechazar)
      :Rechazar solicitud;
      :Ingresar motivo de rechazo;
      
      |Sistema|
      :Actualizar Solicitud\n(status = 'rejected');
      :Registrar motivo de rechazo\ny fecha;
      :Actualizar todos los RequestItem\n(status = 'rejected');
      :Enviar notificación al usuario\n(request_rejected);
      
      |Usuario (Solicitante)|
      :Recibir notificación\n"Solicitud rechazada"\ncon motivo;
      
    endif
    
  else (No)
    :Mostrar error:\n"Stock insuficiente";
    
    |Usuario (Solicitante)|
    :Ajustar cantidades o\nseleccionar otros insumos;
    
  endif
  
else (No)
  :Mostrar errores de validación;
  
  |Usuario (Solicitante)|
  :Corregir datos del formulario;
  
endif

stop

legend right
  |= Estado |= Descripción |
  | pending | Solicitud pendiente de revisión |
  | approved | Solicitud aprobada por admin |
  | rejected | Solicitud rechazada por admin |
endlegend

@enduml
